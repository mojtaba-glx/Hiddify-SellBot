# Required
ADMIN_ID=
ADMIN_BOT_TOKEN=
USER_BOT_TOKEN=

# Agency/Reseller Bot (optional)
# Separate bot token for agents/resellers to manage their customers & services.
AGENT_BOT_TOKEN=

# Optional
SUB_BOT_USERNAME=
# Public host/domain used for managed multi-server subscription links (optional)
# Example: site.example.com or 203.0.113.10
# SUB_SERVER_PUBLIC_HOST=

# Optional: add a fake Trojan status line at the top of managed subscriptions.
# This helps apps like v2rayNG show usage/time inside the config list.
SUB_STATUS_CONFIG_ENABLED=true
SUB_STATUS_CONFIG_HOST=status.hiddify-sellbot.invalid
SUB_STATUS_CONFIG_SNI=status.hiddify-sellbot.invalid
SUB_STATUS_CONFIG_PORT=443

# Global usage enforcement (automatic multi-server usage sync + cutoff)
GLOBAL_ENFORCER_ENABLED=1
GLOBAL_ENFORCER_INTERVAL_SECONDS=20
HIDDIFY_API_TIMEOUT_SECONDS=6
# Retry transient Hiddify API network errors (ConnectTimeout, ReadTimeout, DNS...).
# POST requests skip retry by default to avoid duplicate user creation; set
# HIDDIFY_API_RETRY_ON_POST=1 to retry them too.
# HIDDIFY_API_RETRY_ATTEMPTS=3
# HIDDIFY_API_RETRY_DELAY_SECONDS=1.5
# HIDDIFY_API_RETRY_ON_POST=0
# Optional panel backup retry tuning. More retries = safer but slower on bad network.
# HIDDIFY_BACKUP_RETRY_ATTEMPTS=3
# HIDDIFY_BACKUP_RETRY_DELAY_SECONDS=2
# Direct-buy delivery: auto-retry transient fulfillment failures before giving up.
# USERBOT_DIRECT_DELIVERY_MAX_RETRIES=5
# USERBOT_DIRECT_DELIVERY_RETRY_DELAY_SECONDS=60
# Workaround for Hiddify panel bug: off | update | toggle
# toggle = create user, save/update it, briefly disable, then enable again.
HIDDIFY_CREATE_USER_STABILIZE_MODE=toggle
GLOBAL_ENFORCER_BATCH_SIZE=30
GLOBAL_ENFORCER_HOT_USAGE_RATIO=0.85
SUB_REMINDER_INTERVAL_SECONDS=300

# Optional anti-spam tuning for user bot
# USERBOT_ACTION_COOLDOWN_SECONDS=1.5
# USERBOT_RATE_LIMIT_NOTICE_SECONDS=5.0
# USERBOT_BUY_MENU_ACTION_COOLDOWN_SECONDS=0
# USERBOT_BUY_CALLBACK_COOLDOWN_SECONDS=0.2
# USERBOT_BUY_MENU_HOLD_SECONDS=1.0

# Optional: Telegram colored button styles (primary/success/danger)
TG_BUTTON_STYLES_ENABLED=true
# Optional fallback theme if database settings are unavailable: smart | shop | pro | minimal
# TG_BUTTON_STYLE_THEME=smart

# Optional: Android SMS verifier webhook for automatic card-to-card approval
# Webhook URL: https://YOUR_SUB_DOMAIN/payment/sms-webhook
# Generate a long random secret and put the same value inside the Android app.
SMS_WEBHOOK_ENABLED=false
SMS_WEBHOOK_SECRET=
# Only match pending card payments created in the last N minutes.
SMS_WEBHOOK_MAX_PENDING_AGE_MINUTES=360

# Optional: delete a service from local DB after N days of continuous "missing" on panel
# USERBOT_MISSING_SERVICE_DELETE_DAYS=7

# Optional: userbot per-action anti-spam throttle (0 = disabled, 1 = enabled)
USERBOT_ANTI_SPAM_ENABLED=0
