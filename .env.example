# Required
ADMIN_ID=
ADMIN_BOT_TOKEN=
USER_BOT_TOKEN=

# Optional
SUB_BOT_USERNAME=
# Public host/domain used for managed multi-server subscription links (optional)
# Example: site.example.com or 203.0.113.10
# SUB_SERVER_PUBLIC_HOST=

# Global usage enforcement (automatic multi-server usage sync + cutoff)
GLOBAL_ENFORCER_ENABLED=1
GLOBAL_ENFORCER_INTERVAL_SECONDS=20
HIDDIFY_API_TIMEOUT_SECONDS=6
GLOBAL_ENFORCER_BATCH_SIZE=30
GLOBAL_ENFORCER_HOT_USAGE_RATIO=0.85
SUB_REMINDER_INTERVAL_SECONDS=300

# Optional anti-spam tuning for user bot
# USERBOT_ACTION_COOLDOWN_SECONDS=1.5
# USERBOT_RATE_LIMIT_NOTICE_SECONDS=5.0

# Optional: Telegram colored button styles (primary/success/danger)
TG_BUTTON_STYLES_ENABLED=true

# Optional: delete a service from local DB after N days of continuous "missing" on panel
# USERBOT_MISSING_SERVICE_DELETE_DAYS=7
